# --- Python environments and caches ---------------------------------------------------
.venv/
venv/
venv-*/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Model caches and weights (downloaded by the setup scripts, never committed) --------
models/
hf_cache/
.cache/
*.safetensors
*.bin
*.pt
*.pth
*.gguf
*.onnx

# --- Benchmark data and results (FLEURS is downloaded on demand) ----------------------------
benchmark/data/
benchmark/results/
mac_selftest_report.txt

# --- Choice remembered by the hardware check (per computer, never committed) --------------------
localtranscribe_settings.json
localtranscribe_settings.json.tmp

# --- Never commit audio, video, transcripts or documents; only tests/ may hold audio -------
*.wav
*.mp3
*.m4a
*.ogg
*.opus
*.flac
*.aac
*.wma
*.amr
*.mp4
*.mkv
*.mov
*.webm
*.docx
*.doc
*.pdf
!tests/*.wav

# Transcripts (*.md, older ones *.txt) anywhere except the files that belong to the repo
*.txt
*.md
!requirements*.txt
!tests/*.txt
!tests/**/*.txt
!README.md
!CLAUDE.md
!/.claude/**
.claude/settings.local.json
*.review.json
/output/
/outputs/
/transcripts/

